# Copy this file to .env at the repository root. Never commit real credentials.
# Chat requires an explicitly selected LLM provider: either set LLM_PROVIDER
# here or pick one in the app's Chat Settings dialog (saved to the gitignored
# backend/.llm_config.json so it survives restarts). LLM_API_BASE alone does
# NOT select a provider. A pasted /v1/chat/completions endpoint is trimmed
# automatically; the OpenAI-compatible /v1 root is derived.
# Presets: Ollama http://localhost:11434, LM Studio http://localhost:1234,
# llama.cpp http://localhost:8080, Unsloth http://127.0.0.1:8888,
# LiteRT-LM http://localhost:9379, OpenAI https://api.openai.com/v1.
LLM_API_BASE=http://127.0.0.1:8080/v1
LLM_API_KEY=dummy
# Required (unless chosen in Settings): ollama | lmstudio | llamacpp | unsloth
# | openai | litert | custom. Selects the provider; any base URL still works.
# LLM_PROVIDER=custom
# Optional: prefer this model id if it appears in GET {LLM_API_BASE}/models.
# LLM_MODEL=
# Optional: sampling temperature (0..2) and extra system-prompt instructions.
# Both can also be changed at runtime in the Chat Settings dialog.
# LLM_TEMPERATURE=0.1
# LLM_SYSTEM_PROMPT=

# Only needed if Google-backed models are enabled again.
GOOGLE_API_KEY=

# Local Sentence Transformers model used to index the knowledge base.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_LOCAL_FILES_ONLY=true
# EMBEDDING_DEVICE=cpu

# --- P0 security ---
# APP_TOKEN gates mutating API calls (PUT /api/llm/config, POST /api/llm/test,
# POST /api/knowledge/upload) via `Authorization: Bearer <token>`. REQUIRED for
# any network-shared deployment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty only for local single-user loopback use.
# APP_TOKEN=
# CREDENTIAL_KEY overrides the Fernet key used to encrypt the stored LLM API
# key (backend/.llm_secret.enc). Default: auto-generated backend/.credential.key
# (0600). Set this to share/persist the secret across machines.
# CREDENTIAL_KEY=
# Bind loopback by default; set HOST=0.0.0.0 only behind an authenticated TLS proxy.
# HOST=127.0.0.1

# --- SSRF policy ---
# Local-first default true keeps Ollama/llama.cpp on localhost/LAN working.
# Cloud deployments MUST set ALLOW_PRIVATE_LLM=false so a stored base URL can
# never point the backend at internal infrastructure (metadata endpoints are
# always denied regardless of this flag).
# ALLOW_PRIVATE_LLM=true

# --- Rate limits (per IP, per minute, in-memory; ALSO limit at ingress in cloud) ---
# RATE_LIMIT_API_PER_MIN=120
# RATE_LIMIT_SENSITIVE_PER_MIN=10

# --- Cloud multi-user (roadmap; single-user runs ignore these) ---
# AUTH_MODE=single        # single-user loopback (default)
# AUTH_MODE=proxy-header  # trust TRUST_PROXY_USER_HEADER from a loopback ingress
#                         # sidecar (e.g. Azure Easy Auth); secrets namespace per user.
# TRUST_PROXY_USER_HEADER=X-MS-CLIENT-PRINCIPAL
# SECRET_BACKEND=local          # or: azure-keyvault (needs `uv sync --group cloud`
#                               # + AZURE_KEY_VAULT_URL + managed identity)
# AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net/

FRONTEND_ORIGIN=http://localhost:4200,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:4200
# Leave empty so plot URLs stay same-origin (/static/...).
PUBLIC_BASE_URL=
PORT=8000

# --- Pluggable MCP domains (no code changes to swap) ---
# ACTIVE_DOMAIN selects the domain pack served by the FastAPI host:
# reliability (default) | physics (example template). The host reads
# backend/src/domains/<name>/{domain.yaml,prompt.md} and connects to the
# servers in backend/config/mcp_servers.<name>.json.
# ACTIVE_DOMAIN=reliability
# MCP_SERVERS_CONFIG overrides the JSON above outright (e.g. point the app at
# the standalone HTTP server: {"mcpServers": {"reliability-engineering":
# {"url": "http://localhost:8001/mcp", "transport": "streamable-http"}}}).
# MCP_SERVERS_CONFIG=
# Standalone domain servers (Open Web UI / Unsloth Studio point at these):
#   python -m src.domains.reliability.server --transport streamable-http --port 8001
# or: .\scripts\mcp.ps1 -Domain reliability (./scripts/mcp.sh reliability)
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8001
# Host ports published by `docker compose` for the standalone MCP services:
# MCP_PUBLISH_PORT=8001
# MCP_PHYSICS_PUBLISH_PORT=8002
# GPU images: default compose images are CPU-only torch (slim). For CUDA
# hosts, overlay the CUDA file (needs NVIDIA Container Toolkit on the host):
#   docker compose -f docker-compose.yml -f docker-compose.cuda.yml up --build -d
# Pick the cuXX channel carrying the locked torch (see docker-compose.cuda.yml).
