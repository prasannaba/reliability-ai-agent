{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Reliability FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "src.host.app",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Launch MCP Backend Server",
      "type": "debugpy",
      "request": "launch",
      "module": "src.domains.reliability.server",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Launch desktop WebView",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/desktop_app.py",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
